# 复制成 .env 再改：cp .env.example .env
# .env 已被 .gitignore 排除，**不要提交**。

# ---- Django ----
# 生成：python -c "import secrets; print(secrets.token_urlsafe(50))"
NGDCS_SECRET_KEY=change-me-to-a-long-random-string
# 生产必须是 0（DEBUG=True 会泄露堆栈和 SQL）
NGDCS_DEBUG=0
# 云服务器上填公网 IP 或域名，逗号分隔
NGDCS_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- 本地开发（不跑 Docker）----
# 本地 MySQL 的 django_user 密码；填了它，python manage.py 才能连库
# NGDCS_DB_PASSWORD=change-me-local-db-password

# ---- MySQL（db 服务与 web 共用这一组；Docker Compose 用）----
MYSQL_DATABASE=myproject
MYSQL_USER=django_user
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# ---- 可选 ----
# 演示数据（manage.py seed_demo 用；不设置就不会生成 demo 管理员）
# DEMO_PASSWORD=change-me-demo-password
# 实时指标：容器内默认 /app/data/server_metrics.csv（compose 已指定）
# GUNICORN_WORKERS=2
# GUNICORN_TIMEOUT=60
